---
import Layout from '../layouts/Layout.astro';
import ServiceProcess from '../components/ServiceProcess.astro';
import ServiceFaq from '../components/ServiceFaq.astro';

const ldJson = [
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.rejimetal.com/" },
      { "@type": "ListItem", "position": 2, "name": "Peldaños metálicos a medida", "item": "https://www.rejimetal.com/peldanos-metalicos-a-medida" }
    ]
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Fabricación de peldaños metálicos de rejilla a medida",
    "description": "Peldaños de rejilla metálica para escaleras industriales, accesos técnicos y reposición.",
    "serviceType": "Fabricación de peldaños metálicos de rejilla a medida",
    "areaServed": { "@type": "AdministrativeArea", "name": "Región de Murcia" },
    "provider": { "@id": "https://www.rejimetal.com/#empresa" }
  })
];
---

<Layout
  title="Peldaños metálicos de rejilla a medida | REJIMETAL"
  description="Peldaños de rejilla metálica a medida para escaleras industriales, accesos técnicos, plataformas, mantenimiento y reposición."
  canonical="https://www.rejimetal.com/peldanos-metalicos-a-medida"
  ogType="website"
  ogTitle="Peldaños metálicos a medida | REJIMETAL"
  ogDescription="Peldaños de rejilla metálica a medida para escaleras industriales, accesos técnicos y reposición."
  ogUrl="https://www.rejimetal.com/peldanos-metalicos-a-medida"
  ldJson={ldJson}
  footerTagline="Peldaños de rejilla metálica a medida"
>
  <section class="service-page-hero service-page-hero--compact">
    <div class="container service-hero-grid">
      <div>
        <p class="eyebrow">Peldaños de rejilla</p>
        <h1>Peldaños metálicos a medida para escaleras industriales</h1>
        <p>Fabricamos peldaños de rejilla definidos por ancho, fondo, apoyo, entorno y uso. Indicados para accesos técnicos, mantenimiento y reposición de escaleras metálicas.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" id="serviceEmail" href="mailto:correo@rejimetal.com">Pedir presupuesto</a>
          <a class="btn btn-secondary" href="/contacto">Enviar medidas o plano</a>
        </div>
      </div>
      <aside class="service-side-note">
        <strong>Trabajo a medida</strong>
        <span>La pieza se define por medidas en mm, apoyo real, uso previsto, entorno y acabado.</span>
      </aside>
    </div>
  </section>

  <section class="section service-detail-section">
    <div class="container service-detail-grid">
      <div class="service-detail-main">
        <p class="eyebrow">Casos habituales</p>
        <div class="service-card-grid">
          <article>
            <h3>Escaleras industriales</h3>
            <p>Peldaños para accesos de mantenimiento, plataformas técnicas y recorridos de operación.</p>
          </article>
          <article>
            <h3>Reposición de peldaños</h3>
            <p>Piezas a medida para sustituir peldaños deteriorados manteniendo apoyo, anchura y fondo existentes.</p>
          </article>
          <article>
            <h3>Nariz y laterales</h3>
            <p>Se estudian remates, laterales o perforaciones si el montaje y el apoyo lo requieren.</p>
          </article>
          <article>
            <h3>Entornos exteriores</h3>
            <p>El acabado se define según humedad, intemperie, tránsito y necesidad de agarre.</p>
          </article>
        </div>
      </div>
      <aside class="info-panel service-data-panel">
        <h2>Datos para preparar el peldaño</h2>
        <ul class="check-list">
          <li>Ancho y fondo en mm.</li>
          <li>Número de peldaños.</li>
          <li>Tipo de escalera y apoyo lateral.</li>
          <li>Uso: mantenimiento, paso habitual o acceso técnico.</li>
          <li>Interior/exterior y presencia de humedad.</li>
          <li>Foto o plano de la escalera.</li>
          <li>Acabado deseado si procede.</li>
        </ul>
        <a class="btn btn-primary" href="/contacto">Contactar con REJIMETAL</a>
      </aside>
    </div>
  </section>

  <ServiceProcess
    steps={[
      { label: '1.', text: 'Envías medidas, plano, croquis, foto o muestra.' },
      { label: '2.', text: 'Se revisa hueco, apoyo, carga aproximada y acabado.' },
      { label: '3.', text: 'Te orientamos y preparamos presupuesto.' },
      { label: '4.', text: 'Fabricamos la pieza a medida cuando la solución es viable.' },
    ]}
  />

  <ServiceFaq
    items={[
      {
        question: '¿Se fabrican peldaños para una escalera existente?',
        answer: 'Sí, si se aportan medidas y fotos del apoyo lateral se puede estudiar la reposición o adaptación.',
      },
      {
        question: '¿Hace falta indicar el sentido de apoyo?',
        answer: 'Sí. En peldaños es importante entender cómo apoya y cómo se fija para evitar errores de montaje.',
      },
      {
        question: '¿Se puede pedir una unidad suelta?',
        answer: 'Se puede estudiar, especialmente en reposiciones o mantenimiento, siempre que la información permita fabricar con criterio.',
      },
    ]}
  />
</Layout>
