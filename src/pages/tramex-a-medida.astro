---
import Layout from '../layouts/Layout.astro';
import ServiceProcess from '../components/ServiceProcess.astro';
import ServiceFaq from '../components/ServiceFaq.astro';

const ldJson = [
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.rejimetal.com/" },
      { "@type": "ListItem", "position": 2, "name": "Tramex a medida", "item": "https://www.rejimetal.com/tramex-a-medida" }
    ]
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Fabricación de tramex y emparrillados metálicos a medida",
    "description": "Tramex y emparrillados metálicos para pasarelas, plataformas, mantenimiento y reposición.",
    "serviceType": "Fabricación de tramex y emparrillados metálicos a medida",
    "areaServed": { "@type": "AdministrativeArea", "name": "Región de Murcia" },
    "provider": { "@id": "https://www.rejimetal.com/#empresa" }
  })
];
---

<Layout
  title="Tramex a medida y emparrillados metálicos | REJIMETAL"
  description="Fabricación de tramex y emparrillados metálicos a medida para pasarelas, plataformas, mantenimiento industrial, reposición y obra."
  canonical="https://www.rejimetal.com/tramex-a-medida"
  ogType="website"
  ogTitle="Tramex a medida | Emparrillados metálicos | REJIMETAL"
  ogDescription="Fabricación de tramex y emparrillados metálicos a medida para pasarelas, plataformas, mantenimiento y reposición."
  ogUrl="https://www.rejimetal.com/tramex-a-medida"
  ldJson={ldJson}
  footerTagline="Tramex y emparrillados a medida"
>
  <section class="service-page-hero service-page-hero--compact">
    <div class="container service-hero-grid">
      <div>
        <p class="eyebrow">Emparrillados metálicos</p>
        <h1>Tramex a medida para paso y mantenimiento</h1>
        <p>Fabricamos tramex y emparrillados metálicos adaptados al hueco, al apoyo y al uso real: plataformas, pasarelas, zonas técnicas, registros y reposiciones.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" id="serviceEmail" href="mailto:correo@rejimetal.com">Pedir presupuesto</a>
          <a class="btn btn-secondary" href="/contacto">Enviar medidas o plano</a>
        </div>
      </div>
      <aside class="service-side-note">
        <strong>Trabajo a medida</strong>
        <span>La pieza se define por medidas en mm, apoyo real, uso previsto, entorno y acabado.</span>
      </aside>
    </div>
  </section>

  <section class="section service-detail-section">
    <div class="container service-detail-grid">
      <div class="service-detail-main">
        <p class="eyebrow">Casos habituales</p>
        <div class="service-card-grid">
          <article>
            <h3>Pasarelas y plataformas</h3>
            <p>Piezas para tránsito técnico, zonas de inspección o mantenimiento, definidas por medida, apoyo y tránsito previsto.</p>
          </article>
          <article>
            <h3>Reposición de tramex</h3>
            <p>Sustitución de piezas antiguas cuando hay que respetar huecos existentes, marcos o apoyos ya construidos.</p>
          </article>
          <article>
            <h3>Acabados según entorno</h3>
            <p>Se revisa si procede acero, galvanizado, inoxidable u otro acabado según humedad, exterior o ambiente agresivo.</p>
          </article>
          <article>
            <h3>Medidas especiales</h3>
            <p>Tramex para dimensiones no estándar, recortes, marcos o piezas que deben integrarse en una instalación existente.</p>
          </article>
        </div>
      </div>
      <aside class="info-panel service-data-panel">
        <h2>Información necesaria</h2>
        <ul class="check-list">
          <li>Medidas exteriores en mm.</li>
          <li>Dimensiones del hueco y apoyo disponible.</li>
          <li>Uso: paso de personas, mantenimiento, ventilación o registro.</li>
          <li>Unidades.</li>
          <li>Entorno y acabado deseado.</li>
          <li>Foto, plano o croquis si existe.</li>
          <li>Carga aproximada o tipo de tránsito.</li>
        </ul>
        <a class="btn btn-primary" href="/contacto">Contactar con REJIMETAL</a>
      </aside>
    </div>
  </section>

  <ServiceProcess
    steps={[
      { label: '1.', text: 'Envías medidas, plano, croquis, foto o muestra.' },
      { label: '2.', text: 'Se revisa hueco, apoyo, carga aproximada y acabado.' },
      { label: '3.', text: 'Te orientamos y preparamos presupuesto.' },
      { label: '4.', text: 'Fabricamos la pieza a medida cuando la solución es viable.' },
    ]}
  />

  <ServiceFaq
    items={[
      {
        question: '¿Tramex y rejilla metálica son lo mismo?',
        answer: 'En uso habitual se emplean como términos cercanos. En presupuesto conviene definir la geometría, malla, apoyo y uso para evitar confusiones.',
      },
      {
        question: '¿Se puede adaptar a un marco existente?',
        answer: 'Sí, se puede estudiar una pieza para un marco o apoyo ya instalado, siempre que se midan bien las cotas reales.',
      },
      {
        question: '¿El acabado se decide al final?',
        answer: 'El acabado se define durante la consulta, porque afecta al entorno, durabilidad, peso y coste de la pieza.',
      },
    ]}
  />
</Layout>
