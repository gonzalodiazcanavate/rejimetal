---
import Layout from '../../layouts/Layout.astro';

const ldJson = [
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.rejimetal.com/" },
      { "@type": "ListItem", "position": 2, "name": "Trabajos realizados", "item": "https://www.rejimetal.com/trabajos" }
    ]
  })
];
---

<Layout
  title="Trabajos con rejillas metálicas para industria | REJIMETAL"
  description="Ámbitos de aplicación de rejillas metálicas a medida para industria aérea, marítima, ferroviaria, plantas industriales y mantenimiento técnico."
  canonical="https://www.rejimetal.com/trabajos"
  ldJson={ldJson}
>
  <section class="section catalog-content work-page work-page--first">
    <div class="container">
      <div class="section-heading section-heading--wide work-page-heading">
        <p class="eyebrow">Aplicaciones industriales</p>
        <h1>Soluciones metálicas a medida para entornos exigentes</h1>
        <p>Una selección visual de sectores donde se aplican emparrillados, peldaños, pasarelas y piezas fabricadas según medidas reales, apoyos, uso previsto y acabado.</p>
      </div>

      <div id="selectedWork" class="selected-work selected-work--sector work-carousel-large" data-sector-carousel aria-live="polite"></div>
    </div>
  </section>

  <div id="workLightbox" class="work-lightbox" hidden aria-modal="true" role="dialog" aria-label="Imagen ampliada de trabajo">
    <button class="work-lightbox-close" type="button" data-lightbox-close aria-label="Cerrar imagen ampliada">×</button>
    <figure class="work-lightbox-panel">
      <img id="workLightboxImage" alt="" />
      <figcaption>
        <span id="workLightboxSector"></span>
        <strong id="workLightboxTitle"></strong>
        <small id="workLightboxText"></small>
      </figcaption>
    </figure>
  </div>

  <Fragment slot="scripts">
    <script>import '../../scripts/work-ui.js';</script>
  </Fragment>
</Layout>
